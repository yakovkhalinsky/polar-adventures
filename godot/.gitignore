# Godot build artefacts. `.godot/` is the imported project cache — regenerated by
# `godot --headless --path godot --import`, so it is build output and must not be
# committed. Same rule the Phaser half of this repo states for `dist/`: nothing
# built is ever committed.
.godot/
build/

# Exported web build, staged for the Pages upload.
export/
