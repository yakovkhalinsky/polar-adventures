node_modules/
dist/
*.local
.DS_Store

# Secrets. `.env` holds the PixelLab API token. The `*.local` rule above does
# NOT cover it, and this repo deploys to GitHub Pages from a public workflow —
# a committed .env is a published key, not just a private one.
.env
.env.*

# Godot build artefacts. `.godot/` is the imported project cache, regenerated by
# `godot --headless --path . --import`, so it is build output and must not be
# committed. Same rule as `dist/` above: nothing built is ever committed.
.godot/
build/
export/

# CCGS ephemeral state. The framework writes session logs and checkpoints here;
# they are per-session scratch, not project history.
production/session-logs/
production/session-state/active.md
project.local.yaml

# Godot must not scan the export output — it would import the built files and write
# .import sidecars into the published directory.
!export/.gdignore
