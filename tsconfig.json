{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    // Matches the official Phaser template. A `body` field declaration on a
    // Phaser GameObject subclass is initialised to `undefined` AFTER super()
    // returns, clobbering the body physics just created. Player.ts sidesteps
    // this with a getter, but the flag stays off for other subclasses.
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
